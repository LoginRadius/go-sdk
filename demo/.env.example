# Copy to .env beside this file and fill in your own values. The demo
# loads that file on startup; exported shell variables override it.
#
# A filled-in .env holds live tenant credentials. It is gitignored — keep it
# that way, and never paste these values into a ticket, chat, or commit.

# ── Required ────────────────────────────────────────────────────────────
# Tenant API key from the LoginRadius admin console.
LR_API_KEY=

# ── Recommended ─────────────────────────────────────────────────────────
# Tenant API secret. Required for endpoints that need server-side auth.
LR_API_SECRET=

# Multi-tenant hosted-page domain (the "tenant name" from the admin console,
# not a hostname). Resolves to https://<LR_DOMAIN>.hub.loginradius.com.
LR_DOMAIN=

# Customer-hosted domain. Resolves to https://<LR_CUSTOM_DOMAIN>. Beats
# LR_DOMAIN when both are set.
LR_CUSTOM_DOMAIN=

# Explicit base URL override (staging, proxy, etc.). Beats both
# LR_CUSTOM_DOMAIN and LR_DOMAIN when set.
LR_BASE_URL=

# ── Optional ────────────────────────────────────────────────────────────
# Listen address. Defaults to ":8080".
LR_DEMO_ADDR=

# URL that LoginRadius embeds in the reset-password email. The user clicks
# this; in a real integration the URL points at a page in your app that
# completes the reset. Demo defaults to http://localhost:8080/reset.
LR_RESET_PASSWORD_URL=

# URL that LoginRadius embeds in the email-verification email. The demo's
# GET /api/auth/verify handler reads ?vtoken=… from the URL, runs
# verification, then redirects to / with a banner. Demo defaults to
# http://localhost:8080/api/auth/verify.
LR_VERIFICATION_URL=

# Name of a custom-object schema configured in the LoginRadius admin console.
# Required by the /api/customobject routes — unlike Java/.NET/PHP's demo, which
# let the client type any object name, this is resolved server-side from here
# so the demo works against one specific schema. Leave unset and those routes
# report which variable is missing rather than failing upstream.
LR_CUSTOM_OBJECT_NAME=
